import React, { useState, useEffect, useRef } from 'react';
import { RotateCcw, Volume2, VolumeX, Sparkles, Activity, Bell, Users, Play, Music, Music3 } from 'lucide-react';

const BOARD_SIZE = 100;
const SNAKES = { 16: 6, 47: 26, 49: 11, 56: 53, 62: 19, 64: 60, 87: 24, 93: 73, 95: 75, 98: 78 };
const LADDERS = { 1: 38, 4: 14, 9: 31, 21: 42, 28: 84, 36: 44, 51: 67, 71: 91, 80: 100 };

const ALL_COLORS = [
  { color: '#06b6d4', tailwind: 'bg-cyan-500', name: 'Cyan Player' },
  { color: '#d946ef', tailwind: 'bg-fuchsia-500', name: 'Magenta Player' },
  { color: '#10b981', tailwind: 'bg-emerald-500', name: 'Emerald Player' },
  { color: '#f59e0b', tailwind: 'bg-amber-500', name: 'Amber Player' }
];

// --- Custom Synthesizer Engine ---
class SynthEngine {
  constructor() {
    this.ctx = null;
    this.muted = false;
  }
  init() {
    if (!this.ctx && !this.muted) {
      try { this.ctx = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) {}
    }
  }
  play(type) {
    if (this.muted || !this.ctx) return;
    if (this.ctx.state === 'suspended') this.ctx.resume();
    const now = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    const gain = this.ctx.createGain();
    osc.connect(gain);
    gain.connect(this.ctx.destination);
    
    if (type === 'step') {
      osc.type = 'sine';
      osc.frequency.setValueAtTime(400, now);
      osc.frequency.exponentialRampToValueAtTime(700, now + 0.1);
      gain.gain.setValueAtTime(0.08, now);
      gain.gain.linearRampToValueAtTime(0, now + 0.1);
      osc.start(now); osc.stop(now + 0.1);
    } else if (type === 'snake') {
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(300, now);
      osc.frequency.exponentialRampToValueAtTime(40, now + 0.8);
      gain.gain.setValueAtTime(0.15, now);
      gain.gain.linearRampToValueAtTime(0, now + 0.8);
      osc.start(now); osc.stop(now + 0.8);
    } else if (type === 'ladder') {
      osc.type = 'square';
      osc.frequency.setValueAtTime(150, now);
      osc.frequency.exponentialRampToValueAtTime(900, now + 0.6);
      gain.gain.setValueAtTime(0.08, now);
      gain.gain.linearRampToValueAtTime(0, now + 0.6);
      osc.start(now); osc.stop(now + 0.6);
    } else if (type === 'roll') {
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(800, now);
      osc.frequency.linearRampToValueAtTime(100, now + 0.3);
      gain.gain.setValueAtTime(0.1, now);
      gain.gain.linearRampToValueAtTime(0, now + 0.3);
      osc.start(now); osc.stop(now + 0.3);
    } else if (type === 'win') {
      [300, 400, 500, 600].forEach((freq, i) => {
        const o = this.ctx.createOscillator();
        const g = this.ctx.createGain();
        o.type = 'triangle'; o.frequency.value = freq;
        o.connect(g); g.connect(this.ctx.destination);
        g.gain.setValueAtTime(0, now);
        g.gain.linearRampToValueAtTime(0.15, now + (i * 0.1) + 0.1);
        g.gain.linearRampToValueAtTime(0, now + 2);
        o.start(now); o.stop(now + 2);
      });
    }
  }
}
const sfx = new SynthEngine();

// --- Helpers ---
const getCellCoords = (cell) => {
  const c = cell - 1;
  const row = Math.floor(c / 10);
  const col = c % 10;
  const x = row % 2 === 0 ? col : 9 - col;
  const y = 9 - row; 
  return { x: x * 10 + 5, y: y * 10 + 5 }; 
};

const getSnakePath = (start, end) => {
  const dx = end.x - start.x; const dy = end.y - start.y;
  const length = Math.sqrt(dx*dx + dy*dy);
  const nx = -dy/length; const ny = dx/length;
  const amp = 8;
  const c1x = start.x + dx*0.25 + nx*amp; const c1y = start.y + dy*0.25 + ny*amp;
  const c2x = start.x + dx*0.75 - nx*amp; const c2y = start.y + dy*0.75 - ny*amp;
  return `M ${start.x} ${start.y} C ${c1x} ${c1y}, ${c2x} ${c2y}, ${end.x} ${end.y}`;
};

const getTokenOffset = (i) => {
  const offsets = ['-6px, -6px', '6px, 6px', '-6px, 6px', '6px, -6px'];
  return offsets[i] || '0, 0';
};

// --- Sub-components ---
const Dice3D = ({ value, rolling, color }) => {
  const getTransform = (val) => {
    switch(val) {
      case 1: return 'rotateX(0deg) rotateY(0deg)';
      case 2: return 'rotateX(-90deg) rotateY(0deg)';
      case 3: return 'rotateX(0deg) rotateY(-90deg)';
      case 4: return 'rotateX(0deg) rotateY(90deg)';
      case 5: return 'rotateX(90deg) rotateY(0deg)';
      case 6: return 'rotateX(180deg) rotateY(0deg)';
      default: return 'rotateX(0deg) rotateY(0deg)';
    }
  };

  const [spin, setSpin] = useState(getTransform(value));
  useEffect(() => {
    if (rolling) setSpin(`rotateX(${Math.floor(Math.random() * 720 + 720)}deg) rotateY(${Math.floor(Math.random() * 720 + 720)}deg) rotateZ(${Math.floor(Math.random() * 360)}deg)`);
    else setSpin(getTransform(value));
  }, [rolling, value]);

  const faceClass = "absolute w-full h-full flex items-center justify-center bg-slate-800/95 border border-slate-600 rounded-2xl shadow-[inset_0_0_20px_rgba(0,0,0,0.8)] backdrop-blur-md";
  const renderDots = (count) => {
    const pos = {
      1: ['col-start-2 row-start-2'],
      2: ['col-start-1 row-start-1', 'col-start-3 row-start-3'],
      3: ['col-start-1 row-start-1', 'col-start-2 row-start-2', 'col-start-3 row-start-3'],
      4: ['col-start-1 row-start-1', 'col-start-3 row-start-1', 'col-start-1 row-start-3', 'col-start-3 row-start-3'],
      5: ['col-start-1 row-start-1', 'col-start-3 row-start-1', 'col-start-2 row-start-2', 'col-start-1 row-start-3', 'col-start-3 row-start-3'],
      6: ['col-start-1 row-start-1', 'col-start-3 row-start-1', 'col-start-1 row-start-2', 'col-start-3 row-start-2', 'col-start-1 row-start-3', 'col-start-3 row-start-3']
    }[count];
    return (
      <div className="grid grid-cols-3 grid-rows-3 gap-1 w-16 h-16 p-1">
        {pos.map((p, i) => (
          <div key={i} className={`${p} flex items-center justify-center`}>
            <div className="w-full h-full rounded-full transition-all duration-300" style={{ backgroundColor: color, boxShadow: `0 0 12px ${color}, 0 0 20px ${color}` }} />
          </div>
        ))}
      </div>
    );
  };

  return (
    <div style={{ perspective: '1000px' }} className="w-24 h-24 my-6 group mx-auto cursor-pointer">
      <div className="w-full h-full transition-transform duration-500 ease-in-out transform group-hover:scale-105" style={{ transform: 'rotateX(-15deg) rotateY(15deg)' }}>
        <div className="w-full h-full relative transition-transform ease-out" style={{ transformStyle: 'preserve-3d', transform: spin, transitionDuration: rolling ? '2000ms' : '1000ms' }}>
          <div className={faceClass} style={{ transform: 'translateZ(48px)' }}>{renderDots(1)}</div>
          <div className={faceClass} style={{ transform: 'rotateX(180deg) translateZ(48px)' }}>{renderDots(6)}</div>
          <div className={faceClass} style={{ transform: 'rotateY(90deg) translateZ(48px)' }}>{renderDots(3)}</div>
          <div className={faceClass} style={{ transform: 'rotateY(-90deg) translateZ(48px)' }}>{renderDots(4)}</div>
          <div className={faceClass} style={{ transform: 'rotateX(90deg) translateZ(48px)' }}>{renderDots(5)}</div>
          <div className={faceClass} style={{ transform: 'rotateX(-90deg) translateZ(48px)' }}>{renderDots(2)}</div>
        </div>
      </div>
    </div>
  );
};

const Confetti = () => (
  <div className="absolute inset-0 pointer-events-none overflow-hidden z-[100]">
    {Array.from({ length: 60 }).map((_, i) => (
      <div key={i} className="absolute w-3 h-8 rounded-full opacity-90 animate-confetti"
        style={{
          left: `${Math.random() * 100}%`, top: `-10%`,
          backgroundColor: ALL_COLORS[Math.floor(Math.random() * 4)].color,
          animationDelay: `${Math.random() * 3}s`,
          animationDuration: `${2 + Math.random() * 3}s`,
        }}
      />
    ))}
  </div>
);

// --- Main App ---
export default function App() {
  const [gameStarted, setGameStarted] = useState(false);
  const [playerCount, setPlayerCount] = useState(2);
  const [players, setPlayers] = useState([]);
  const [currentPlayer, setCurrentPlayer] = useState(0);
  const [diceValue, setDiceValue] = useState(1);
  const [rolling, setRolling] = useState(false);
  const [gameOver, setGameOver] = useState(false);
  const [logs, setLogs] = useState([]);
  
  const [voiceEnabled, setVoiceEnabled] = useState(true);
  const [soundEnabled, setSoundEnabled] = useState(true);
  const [shakeBoard, setShakeBoard] = useState(false);

  useEffect(() => { sfx.muted = !soundEnabled; }, [soundEnabled]);

  const speak = (text) => {
    if (voiceEnabled && 'speechSynthesis' in window) {
      window.speechSynthesis.cancel(); 
      const msg = new SpeechSynthesisUtterance(text);
      msg.rate = 1.05; msg.pitch = 1.1;
      window.speechSynthesis.speak(msg);
    }
  };

  const addLog = (text) => {
    setLogs(prev => [{ id: Date.now() + Math.random(), text }, ...prev].slice(0, 10));
  };

  const startGame = () => {
    sfx.init();
    const newPlayers = ALL_COLORS.slice(0, playerCount).map((c, i) => ({ id: i + 1, pos: 1, ...c }));
    setPlayers(newPlayers);
    setCurrentPlayer(0); setDiceValue(1); setGameOver(false); setGameStarted(true);
    setLogs([{ id: Date.now(), text: `Game started with ${playerCount} players! ✨` }]);
    speak(`Game started. ${newPlayers[0].name}, your turn.`);
  };

  const updatePlayerPos = (playerIndex, newPos) => {
    setPlayers(prev => prev.map((p, i) => i === playerIndex ? { ...p, pos: newPos } : p));
  };

  const handleRoll = async () => {
    if (rolling || gameOver || !gameStarted) return;
    setRolling(true);
    sfx.play('roll');
    
    const activePlayer = players[currentPlayer];
    const roll = Math.floor(Math.random() * 6) + 1;
    setDiceValue(roll);
    setTimeout(() => speak(`Rolled a ${roll}`), 200);

    await new Promise(r => setTimeout(r, 1200)); 

    let currentPos = activePlayer.pos;
    let targetPos = currentPos + roll;

    if (targetPos > BOARD_SIZE) {
      const msg = `Overshot! Needs exactly ${BOARD_SIZE - currentPos} to win!`;
      addLog(`${activePlayer.name}: ${msg}`);
      speak(msg);
      await new Promise(r => setTimeout(r, 1500));
    } else {
      addLog(`${activePlayer.name} rolls ${roll}...`);
      
      for (let step = 1; step <= roll; step++) {
        currentPos++;
        updatePlayerPos(currentPlayer, currentPos);
        sfx.play('step');
        await new Promise(r => setTimeout(r, 250)); 
      }

      if (currentPos === BOARD_SIZE) {
        setGameOver(true);
        sfx.play('win');
        const winMsg = `${activePlayer.name} takes the Crown!`;
        addLog(`🎉 ${winMsg} 🎉`);
        speak(winMsg);
        setRolling(false);
        return;
      }

      if (SNAKES[currentPos]) {
        const msg = `Oh no! Snake bite down to ${SNAKES[currentPos]}!`;
        addLog(`🐍 ${msg}`); speak("Snake bite!");
        setShakeBoard(true);
        sfx.play('snake');
        await new Promise(r => setTimeout(r, 600)); 
        currentPos = SNAKES[currentPos];
        updatePlayerPos(currentPlayer, currentPos);
        await new Promise(r => setTimeout(r, 1000)); 
        setShakeBoard(false);
      } else if (LADDERS[currentPos]) {
        const msg = `Awesome! Climbs ladder to ${LADDERS[currentPos]}!`;
        addLog(`🪜 ${msg}`); speak("Climbing up!");
        sfx.play('ladder');
        await new Promise(r => setTimeout(r, 600)); 
        currentPos = LADDERS[currentPos];
        updatePlayerPos(currentPlayer, currentPos);
        await new Promise(r => setTimeout(r, 1000)); 
      }
    }

    setCurrentPlayer(prev => (prev + 1) % players.length);
    setRolling(false);
  };

  return (
    <>
      {/* Injecting custom keyframes directly */}
      <style>{`
        @keyframes shake {
          0%, 100% { transform: translateX(0) rotate(0deg); }
          20%, 60% { transform: translateX(-10px) rotate(-1.5deg); }
          40%, 80% { transform: translateX(10px) rotate(1.5deg); }
        }
        .animate-shake { animation: shake 0.6s cubic-bezier(.36,.07,.19,.97) both; }
        @keyframes confetti {
          0% { transform: translateY(0) rotate(0deg); opacity: 1; }
          100% { transform: translateY(120vh) rotate(720deg); opacity: 0; }
        }
        .animate-confetti { animation: confetti linear forwards; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(30, 41, 59, 0.5); border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(71, 85, 105, 0.8); border-radius: 10px; }
      `}</style>

      <div className="min-h-screen bg-[#09090b] bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-slate-900 via-[#09090b] to-black flex items-center justify-center p-4 md:p-6 font-sans text-slate-200 overflow-hidden relative">
        
        {/* Background Atmosphere */}
        <div className="absolute top-[-20%] left-[-10%] w-[40rem] h-[40rem] bg-cyan-600/10 rounded-full blur-[150px] pointer-events-none" />
        <div className="absolute bottom-[-20%] right-[-10%] w-[40rem] h-[40rem] bg-fuchsia-600/10 rounded-full blur-[150px] pointer-events-none" />

        {!gameStarted && (
          <div className="absolute inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xl">
            <div className="bg-slate-900/90 border border-slate-700/50 p-10 rounded-[2.5rem] shadow-[0_0_100px_rgba(0,0,0,1)] flex flex-col items-center max-w-md w-full mx-4 relative overflow-hidden">
              <div className="absolute top-0 w-full h-1 bg-gradient-to-r from-cyan-500 via-fuchsia-500 to-amber-500" />
              <h1 className="text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-500 mb-8 tracking-tighter drop-shadow-lg">OVERDRIVE</h1>
              
              <div className="w-full space-y-6 mb-8">
                <div>
                  <label className="text-sm font-bold text-slate-400 uppercase tracking-widest mb-3 block flex items-center gap-2"><Users size={16}/> Select Players</label>
                  <div className="flex gap-3">
                    {[2, 3, 4].map(num => (
                      <button key={num} onClick={() => setPlayerCount(num)} className={`flex-1 py-3 rounded-xl font-bold text-lg transition-all ${playerCount === num ? 'bg-fuchsia-500 text-white shadow-[0_0_20px_rgba(217,70,239,0.4)] scale-105' : 'bg-slate-800 text-slate-400 hover:bg-slate-700'}`}>
                        {num}
                      </button>
                    ))}
                  </div>
                </div>
              </div>

              <button onClick={startGame} className="w-full py-4 rounded-2xl font-black text-xl uppercase tracking-wider bg-slate-100 text-slate-900 hover:bg-white hover:scale-105 transition-all shadow-[0_0_30px_rgba(255,255,255,0.2)] flex items-center justify-center gap-3">
                <Play className="fill-slate-900" size={24} /> Start Game
              </button>
            </div>
          </div>
        )}

        {gameStarted && (
          <div className="max-w-[90rem] w-full grid grid-cols-1 lg:grid-cols-4 gap-6 relative z-10 h-[95vh] lg:h-auto">
            
            {/* LEFT PANEL: Dashboard & Logs */}
            <div className="lg:col-span-1 hidden lg:flex flex-col gap-6 order-3 lg:order-1 h-full max-h-[85vh]">
              {/* Leaderboard */}
              <div className="bg-slate-900/50 backdrop-blur-xl p-6 rounded-3xl border border-slate-700/50 shadow-2xl">
                <div className="flex justify-between items-center mb-5">
                  <h3 className="text-xs font-bold text-slate-400 tracking-widest uppercase flex items-center gap-2"><Activity size={16}/> Race to 100</h3>
                  {/* Settings toggles */}
                  <div className="flex gap-2">
                    <button onClick={() => setSoundEnabled(!soundEnabled)} className={`p-1.5 rounded-full transition-colors ${soundEnabled ? 'text-cyan-400 bg-cyan-950/50' : 'text-slate-600'}`}>{soundEnabled ? <Music size={14}/> : <Music3 size={14}/>}</button>
                    <button onClick={() => { setVoiceEnabled(!voiceEnabled); if(!voiceEnabled) speak("Voice on"); }} className={`p-1.5 rounded-full transition-colors ${voiceEnabled ? 'text-fuchsia-400 bg-fuchsia-950/50' : 'text-slate-600'}`}>{voiceEnabled ? <Volume2 size={14}/> : <VolumeX size={14}/>}</button>
                  </div>
                </div>
                <div className="space-y-4">
                  {[...players].sort((a, b) => b.pos - a.pos).map(p => (
                    <div key={p.id} className="w-full flex items-center gap-3">
                      <div className="w-7 h-7 rounded-full flex items-center justify-center font-bold text-[10px] bg-slate-950 text-white shadow-lg" style={{ border: `2px solid ${p.color}` }}>P{p.id}</div>
                      <div className="flex-1 h-2.5 bg-slate-950 rounded-full overflow-hidden relative shadow-inner">
                        <div className="absolute top-0 left-0 h-full transition-all duration-700 ease-out" style={{ width: `${p.pos}%`, backgroundColor: p.color, boxShadow: `0 0 10px ${p.color}` }} />
                      </div>
                      <div className="text-xs font-bold w-6 text-right tabular-nums" style={{ color: p.color }}>{p.pos}</div>
                    </div>
                  ))}
                </div>
              </div>

              {/* Action Log */}
              <div className="bg-slate-900/50 backdrop-blur-xl p-5 rounded-3xl border border-slate-700/50 shadow-2xl flex-1 overflow-hidden flex flex-col">
                <h3 className="text-xs font-bold text-slate-400 mb-4 tracking-widest uppercase flex items-center gap-2"><Bell size={16}/> Live Feed</h3>
                <div className="flex-1 overflow-y-auto space-y-3 pr-2 custom-scrollbar">
                  {logs.map((log, i) => (
                    <div key={log.id} className={`text-sm p-3 rounded-xl border ${i === 0 ? 'bg-slate-800/80 border-slate-600 text-slate-100 shadow-lg scale-100' : 'bg-slate-800/20 border-transparent text-slate-500 scale-95 opacity-70'} transition-all duration-500 transform origin-top`}>
                      {log.text}
                    </div>
                  ))}
                </div>
              </div>
            </div>

            {/* CENTER PANEL: Game Board */}
            <div className={`lg:col-span-2 order-1 lg:order-2 relative bg-slate-900/60 backdrop-blur-2xl p-3 sm:p-5 rounded-[2.5rem] shadow-[0_0_80px_rgba(0,0,0,0.6)] border border-slate-700/50 flex items-center justify-center transition-transform ${shakeBoard ? 'animate-shake' : ''}`}>
              <div className="relative w-full max-w-2xl aspect-square bg-slate-950/80 rounded-3xl overflow-hidden shadow-[inset_0_0_40px_rgba(0,0,0,0.8)] border-[0.5px] border-slate-700">
                
                {/* SVG Filters */}
                <svg width="0" height="0" className="absolute">
                  <defs>
                    <filter id="neon-glow-cyan" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="3" result="blur" /><feComposite in="SourceGraphic" in2="blur" operator="over" /></filter>
                    <filter id="neon-glow-red" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="4" result="blur" /><feComposite in="SourceGraphic" in2="blur" operator="over" /></filter>
                  </defs>
                </svg>

                {/* Grid Cells */}
                <div className="absolute inset-0 grid grid-cols-10 grid-rows-10">
                  {Array.from({ length: 100 }).map((_, i) => {
                    const row = Math.floor(i / 10); const col = i % 10;
                    const mathRow = 9 - row;
                    const cellNum = mathRow % 2 === 0 ? mathRow * 10 + col + 1 : mathRow * 10 + (9 - col) + 1;
                    const isAlt = (row + col) % 2 === 0;

                    return (
                      <div key={cellNum} className={`flex items-center justify-center relative text-[10px] sm:text-xs font-black border-[0.5px] border-slate-800/40 ${isAlt ? 'bg-slate-800/20' : 'bg-transparent'}`}>
                        <span className={`pointer-events-none select-none ${cellNum === 1 || cellNum === 100 ? 'text-2xl z-0 drop-shadow-md' : 'text-slate-700'}`}>
                          {cellNum === 1 ? '🏁' : cellNum === 100 ? '👑' : cellNum}
                        </span>
                      </div>
                    );
                  })}
                </div>

                {/* SVG Snakes & Ladders */}
                <svg viewBox="0 0 100 100" className="absolute inset-0 w-full h-full pointer-events-none z-10" preserveAspectRatio="none">
                  {Object.entries(LADDERS).map(([start, end]) => {
                    const s = getCellCoords(Number(start)); const e = getCellCoords(Number(end));
                    return (
                      <g key={`ladder-${start}`} filter="url(#neon-glow-cyan)">
                        <line x1={s.x-1.8} y1={s.y} x2={e.x-1.8} y2={e.y} stroke="#0ea5e9" strokeWidth="0.8" strokeLinecap="round" opacity="0.9" />
                        <line x1={s.x+1.8} y1={s.y} x2={e.x+1.8} y2={e.y} stroke="#0ea5e9" strokeWidth="0.8" strokeLinecap="round" opacity="0.9" />
                        <line x1={s.x} y1={s.y} x2={e.x} y2={e.y} stroke="#38bdf8" strokeWidth="3.6" strokeDasharray="1.2 3.5" opacity="0.9" />
                      </g>
                    );
                  })}
                  {Object.entries(SNAKES).map(([start, end]) => {
                    const s = getCellCoords(Number(start)); const e = getCellCoords(Number(end));
                    const path = getSnakePath(s, e);
                    return (
                      <g key={`snake-${start}`} filter="url(#neon-glow-red)">
                        <path d={path} stroke="#ef4444" strokeWidth="1.8" fill="none" strokeLinecap="round" opacity="0.85" />
                        <path d={path} stroke="#fca5a5" strokeWidth="0.5" fill="none" strokeLinecap="round" opacity="1" />
                        <circle cx={s.x} cy={s.y} r="1.8" fill="#b91c1c" />
                        <circle cx={s.x-0.5} cy={s.y-0.5} r="0.4" fill="#fef2f2" />
                        <circle cx={s.x+0.5} cy={s.y-0.5} r="0.4" fill="#fef2f2" />
                      </g>
                    );
                  })}
                </svg>

                {/* Player Tokens */}
                {players.map((p, i) => {
                  const pos = getCellCoords(p.pos);
                  const isActive = i === currentPlayer;
                  return (
                    <div key={i}
                      className={`absolute w-5 h-5 sm:w-7 sm:h-7 -mt-2.5 -ml-2.5 sm:-mt-3.5 sm:-ml-3.5 rounded-full transition-all duration-300 ease-in-out ${isActive ? 'z-30 scale-125' : 'z-20 scale-100'}`}
                      style={{
                        left: `${pos.x}%`, top: `${pos.y}%`,
                        transform: `translate(${getTokenOffset(i)}) ${isActive && !rolling ? 'translateY(-2px)' : ''}`,
                        backgroundColor: p.color,
                        boxShadow: isActive ? `0 0 20px ${p.color}, inset 0 2px 4px rgba(255,255,255,0.8)` : `0 0 8px ${p.color}, inset 0 2px 4px rgba(255,255,255,0.4)`,
                        border: `2px solid ${isActive ? '#fff' : 'rgba(255,255,255,0.5)'}`
                      }}
                    />
                  );
                })}
              </div>

              {/* Game Over Screen inside board */}
              {gameOver && (
                <div className="absolute inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm rounded-[2.5rem] animate-in fade-in duration-500 overflow-hidden">
                  <Confetti />
                  <div className="bg-slate-900/90 border border-slate-600 p-10 rounded-3xl shadow-[0_0_80px_rgba(0,0,0,0.8)] flex flex-col items-center transform scale-110 z-10 relative">
                    <Sparkles className="w-20 h-20 text-yellow-400 mb-6 animate-pulse" />
                    <h2 className="text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 to-amber-600 mb-2">VICTORY!</h2>
                    <p className="text-2xl text-white font-black mb-8 drop-shadow-md" style={{ color: players[currentPlayer].color }}>{players[currentPlayer].name}</p>
                    <button onClick={() => setGameStarted(false)} className="px-10 py-5 bg-gradient-to-r from-slate-100 to-slate-300 text-slate-900 rounded-2xl font-black text-xl hover:scale-105 transition-all active:scale-95 shadow-[0_0_30px_rgba(255,255,255,0.3)] flex items-center gap-3">
                      <RotateCcw className="w-6 h-6" /> Play Again
                    </button>
                  </div>
                </div>
              )}
            </div>

            {/* RIGHT PANEL: Controls & Turn */}
            <div className="lg:col-span-1 order-2 lg:order-3 flex flex-col justify-center gap-6 h-full">
              <div className="bg-slate-900/50 backdrop-blur-xl p-6 sm:p-8 rounded-[2.5rem] shadow-2xl border border-slate-700/50 flex flex-col items-center relative flex-1 lg:flex-none justify-center">
                
                {/* Active Player Card */}
                <div className="w-full bg-slate-950/80 border border-slate-800 rounded-2xl p-6 flex flex-col items-center shadow-inner relative overflow-hidden mb-6 transition-all duration-500" style={{ boxShadow: `0 0 30px ${players[currentPlayer]?.color}20` }}>
                  <div className="absolute top-0 w-full h-1" style={{ backgroundColor: players[currentPlayer]?.color, boxShadow: `0 0 15px ${players[currentPlayer]?.color}` }} />
                  <span className="text-xs font-bold text-slate-500 tracking-widest uppercase mb-2">Current Turn</span>
                  <div className="flex items-center gap-3">
                    <div className="w-4 h-4 rounded-full animate-pulse" style={{ backgroundColor: players[currentPlayer]?.color, boxShadow: `0 0 15px ${players[currentPlayer]?.color}` }} />
                    <h2 className="text-2xl font-black tracking-tight" style={{ color: players[currentPlayer]?.color }}>{players[currentPlayer]?.name}</h2>
                  </div>
                </div>

                {/* The 3D Dice Component */}
                <div onClick={handleRoll} className={`${rolling || gameOver ? 'pointer-events-none' : ''}`}>
                  <Dice3D value={diceValue} rolling={rolling} color={players[currentPlayer]?.color} />
                </div>

                {/* Roll Button */}
                <button
                  onClick={handleRoll} disabled={rolling || gameOver}
                  className={`w-full py-5 rounded-2xl font-black text-xl uppercase tracking-widest transition-all duration-300 relative overflow-hidden group ${rolling || gameOver ? 'bg-slate-800 text-slate-600 shadow-none' : 'bg-slate-100 text-slate-900 hover:scale-[1.03] active:scale-95 shadow-[0_0_30px_rgba(255,255,255,0.2)] hover:shadow-[0_0_40px_rgba(255,255,255,0.4)]'}`}
                >
                  <div className="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out" />
                  <span className="relative z-10">{rolling ? 'ROLLING...' : 'ROLL DICE'}</span>
                </button>
              </div>
            </div>

          </div>
        )}
      </div>
    </>
  );
}
